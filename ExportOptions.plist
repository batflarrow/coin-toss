<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Manual signing on purpose: automatic signing would let Xcode regenerate
	     signing assets for the whole team, and this account also ships another
	     app that depends on the existing distribution certificate. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>56KRZRUNG9</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<!-- The watch-only container, the watch app it carries, and the widget
	     extension nested in that are all re-signed at export with manual
	     signing, so every bundle ID that needs a profile must be listed. -->
	<key>provisioningProfiles</key>
	<dict>
		<key>com.batflarrow.CoinToss</key>
		<string>Coin Toss App Store</string>
		<key>com.batflarrow.CoinToss.watchkitapp</key>
		<string>Coin Toss Watch App Store</string>
		<key>com.batflarrow.CoinToss.watchkitapp.widget</key>
		<string>Coin Toss Widget App Store</string>
	</dict>
	<key>uploadSymbols</key>
	<true/>
	<key>destination</key>
	<string>upload</string>
</dict>
</plist>
